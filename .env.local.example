# Upstream public aggregate endpoint (GET {DATA_SOURCE_URL}?year=YYYY,
# returning a RingAggregate). Leave empty to use the deterministic mock.
#
# Reference upstream:
#   DATA_SOURCE_URL=https://app.yuzu.style/api/public/weekly
#
# Note that a shape-valid upstream whose weeks are all below the anonymity
# threshold still falls back to the mock — see lib/data-source.ts.
DATA_SOURCE_URL=

{
  "name": "yuzu-block",
  "version": "0.1.0",
  "private": true,
  "description": "Renders anonymous, aggregate-only voice-journal data as a 3D block sculpture, plus an auth-free MCP server serving the same aggregates.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:brand": "node scripts/check-brand-words.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:brand",
    "deploy:status": "node scripts/deploy-status.mjs",
    "deploy:wait": "node scripts/deploy-status.mjs -- --wait"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "mcp-handler": "1.1.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
